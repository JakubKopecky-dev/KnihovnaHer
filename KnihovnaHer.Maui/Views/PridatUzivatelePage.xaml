<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.PridatUzivatelePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="🆕 Vytvořit uživatele"
    x:DataType="viewModels:PridatUzivateleViewModel"
    BackgroundColor="#f2f2f2">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="40"
                Spacing="16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="900"
                WidthRequest="700">
                <!-- 💡 ZARUČENĚ šířka -->

                <Label FontSize="20" Text="Email" Margin="0,8,0,0" />
                <Border Padding="10" BackgroundColor="#eeeeee" StrokeShape="RoundRectangle 8">
                    <Entry
                        FontSize="16"
                        Placeholder="Email"
                        Text="{Binding Email}"
                        HorizontalOptions="Fill" />
                </Border>

                <Label FontSize="20" Text="Heslo" Margin="0,12,0,0" />
                <Border Padding="10" BackgroundColor="#eeeeee" StrokeShape="RoundRectangle 8">
                    <Entry
                        FontSize="16"
                        IsPassword="True"
                        Placeholder="Heslo"
                        Text="{Binding Password}"
                        HorizontalOptions="Fill" />
                </Border>

                <Label FontSize="20" Text="Role" Margin="0,12,0,0" />
                <HorizontalStackLayout Spacing="12" Padding="0,4,0,0">
                    <CheckBox IsChecked="{Binding IsAdmin, Mode=OneWayToSource}" />
                    <Label FontSize="16" VerticalOptions="Center" Text="Administrátor" />
                </HorizontalStackLayout>

                <Button
                    x:Name="SaveButton"
                    Margin="0,20,0,0"
                    Padding="16"
                    BackgroundColor="#4CAF50"
                    Clicked="OnUlozitClicked"
                    CornerRadius="12"
                    FontSize="18"
                    Text="Vytvořit uživatele"
                    TextColor="White"
                    HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
