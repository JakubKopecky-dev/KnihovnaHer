<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.SeznamHerObecnyUzivatelPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KnihovnaHer.Maui"
    xmlns:models="clr-namespace:KnihovnaHer.Dto;assembly=KnihovnaHer.Dto"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="🎮 Seznam Her"
    x:DataType="viewModels:SeznamHerViewModel">



    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="16"
                BackgroundColor="#f2f2f2"
                Spacing="12">



                <!--  CollectionView (viditelné jen když nenačítá)  -->
                <CollectionView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" ItemsSource="{Binding Hry}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:HraDto">
                            <Border
                                Margin="0,5"
                                Padding="12"
                                BackgroundColor="White"
                                Stroke="#cccccc"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">

                                <Grid
                                    ColumnDefinitions="2*,2*,1*,3*,auto"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto">

                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding Nazev}"
                                        TextColor="#222"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        FontSize="14"
                                        Text="{Binding Vydavatel.Nazev}"
                                        TextColor="#555"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="2"
                                        FontSize="14"
                                        Text="{Binding RokVydani}"
                                        TextColor="#777"
                                        VerticalOptions="Center" />

                                    <FlexLayout
                                        Grid.Column="3"
                                        AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding Zanry}"
                                        Direction="Row"
                                        JustifyContent="Start"
                                        Wrap="Wrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Margin="2"
                                                    Padding="6,2"
                                                    BackgroundColor="#e0e0e0"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding}"
                                                        TextColor="#333" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>

                                    <Button
                                        Grid.Column="4"
                                        Padding="8,4"
                                        BackgroundColor="#FFC107"
                                        Clicked="OnPridatStatusHryClicked"
                                        CornerRadius="10"
                                        FontSize="15"
                                        HeightRequest="36"
                                        HorizontalOptions="Center"
                                        Text="Přidat"
                                        TextColor="Black"
                                        WidthRequest="90" />


                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Spinner přes CollectionView  -->
        <ActivityIndicator
            HeightRequest="80"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="80"
            Color="DarkBlue" />
    </Grid>
</ContentPage>