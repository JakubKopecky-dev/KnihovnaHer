<ContentPage
    x:Class="KnihovnaHer.Maui.Views.ZanrVydavatelPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KnihovnaHer.Maui"
    xmlns:models="clr-namespace:KnihovnaHer.Dto;assembly=KnihovnaHer.Dto"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="🎭🏢 Žánry a Vydavatelé"
    x:DataType="viewModels:ZanrVydavatelViewModel">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="16"
                BackgroundColor="#f9f9f9"
                Spacing="20">

                <!--  Tlačítka  -->
                <HorizontalStackLayout Margin="0,0,0,7" Spacing="30">
                    <Button
                        Padding="10"
                        BackgroundColor="#4caf50"
                        Clicked="OnAddZanrClicked"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="Přidat žánr"
                        TextColor="White" />

                    <Button
                        Padding="10"
                        BackgroundColor="#2196f3"
                        Clicked="OnAddVydavatelClicked"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="Přidat vydavatele"
                        TextColor="White" />
                </HorizontalStackLayout>

                <!--  Žánry  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="🎭 Žánry"
                    TextColor="#222" />

                <CollectionView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" ItemsSource="{Binding Zanry}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ZanrDto">
                            <Border
                                Margin="0,5"
                                Padding="10"
                                BackgroundColor="White"
                                Stroke="#ccc"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid
                                    ColumnDefinitions="*,auto"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto">

                                    <Label
                                        FontSize="16"
                                        Text="{Binding Nazev}"
                                        TextColor="#333"
                                        VerticalOptions="Center" />

                                    <Button
                                        Grid.Column="1"
                                        Padding="5"
                                        BackgroundColor="#F44336"
                                        Clicked="OnDeleteZanrClicked"
                                        Text="Odstranit"
                                        TextColor="Black" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--  Vydavatelé  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="🏢 Vydavatelé"
                    TextColor="#222" />

                <CollectionView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" ItemsSource="{Binding Vydavatele}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VydavatelDto">
                            <Border
                                Margin="0,5"
                                Padding="10"
                                BackgroundColor="White"
                                Stroke="#ccc"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid
                                    ColumnDefinitions="*,auto"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto">

                                    <Label
                                        FontSize="16"
                                        Text="{Binding Nazev}"
                                        TextColor="#333"
                                        VerticalOptions="Center" />

                                    <Button
                                        Grid.Column="1"
                                        Padding="5"
                                        BackgroundColor="#F44336"
                                        Clicked="OnDeleteVydavatelClicked"
                                        Text="Odstranit"
                                        TextColor="Black" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Spinner  -->
        <ActivityIndicator
            HeightRequest="80"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="80"
            Color="DarkBlue" />
    </Grid>
</ContentPage>
