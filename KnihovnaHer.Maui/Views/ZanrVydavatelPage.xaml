<ContentPage
    x:Class="KnihovnaHer.Maui.Views.ZanrVydavatelPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:KnihovnaHer.Dto;assembly=KnihovnaHer.Dto"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="🎭🏢 Žánry a Vydavatelé"
    x:DataType="viewModels:ZanrVydavatelViewModel">

    <Grid BackgroundColor="#f9f9f9">
        <ScrollView>
            <VerticalStackLayout
                Padding="16"
                HorizontalOptions="Center"
                MaximumWidthRequest="900"
                Spacing="20">

                <!--  Tlačítka  -->
                <FlexLayout
                    Margin="0,0,0,10"
                    AlignItems="Center"
                    Direction="Row"
                    JustifyContent="Start"
                    Wrap="Wrap">
                    <Button
                        Margin="5"
                        BackgroundColor="#4caf50"
                        Clicked="OnAddZanrClicked"
                        CornerRadius="8"
                        FontSize="14"
                        HeightRequest="40"
                        Text="Přidat žánr"
                        TextColor="White"
                        WidthRequest="140" />

                    <Button
                        Margin="5"
                        BackgroundColor="#2196f3"
                        Clicked="OnAddVydavatelClicked"
                        CornerRadius="8"
                        FontSize="14"
                        HeightRequest="40"
                        Text="Přidat vydavatele"
                        TextColor="White"
                        WidthRequest="170" />
                </FlexLayout>

                <!--  Žánry  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="🎭 Žánry"
                    TextColor="#222" />

                <CollectionView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" ItemsSource="{Binding Zanry}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ZanrDto">
                            <Border
                                Margin="0,5"
                                Padding="12"
                                BackgroundColor="White"
                                Stroke="#ccc"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <Grid ColumnDefinitions="*,auto" ColumnSpacing="10">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding Nazev}"
                                        TextColor="#333"
                                        VerticalOptions="Center" />

                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#F44336"
                                        Clicked="OnDeleteZanrClicked"
                                        CornerRadius="8"
                                        FontSize="14"
                                        HeightRequest="36"
                                        Text="Odstranit"
                                        TextColor="White"
                                        WidthRequest="100" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--  Vydavatelé  -->
                <Label
                    Margin="0,20,0,0"
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="🏢 Vydavatelé"
                    TextColor="#222" />

                <CollectionView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" ItemsSource="{Binding Vydavatele}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VydavatelDto">
                            <Border
                                Margin="0,5"
                                Padding="12"
                                BackgroundColor="White"
                                Stroke="#ccc"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <Grid ColumnDefinitions="*,auto" ColumnSpacing="10">
                                    <Label
                                        FontSize="16"
                                        Text="{Binding Nazev}"
                                        TextColor="#333"
                                        VerticalOptions="Center" />

                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#F44336"
                                        Clicked="OnDeleteVydavatelClicked"
                                        CornerRadius="8"
                                        FontSize="14"
                                        HeightRequest="36"
                                        Text="Odstranit"
                                        TextColor="White"
                                        WidthRequest="100" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Loader  -->
        <ActivityIndicator
            HeightRequest="80"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="80"
            Color="DarkBlue" />
    </Grid>
</ContentPage>
