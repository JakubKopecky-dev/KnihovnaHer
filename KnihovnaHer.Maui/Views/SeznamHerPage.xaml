<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.SeznamHerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:KnihovnaHer.Dto;assembly=KnihovnaHer.Dto"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="🎮 Seznam Her - Administrátor"
    x:DataType="viewModels:SeznamHerViewModel">

    <Grid BackgroundColor="#f2f2f2" RowDefinitions="Auto,*">

        <!--  Tlačítka  -->
        <ScrollView Grid.Row="0" Orientation="Horizontal">
            <FlexLayout
                Padding="16"
                Direction="Row"
                JustifyContent="Start"
                Wrap="Wrap">
                <Button
                    Margin="5"
                    BackgroundColor="#4caf50"
                    Clicked="OnAddGameClicked"
                    CornerRadius="8"
                    FontSize="14"
                    HeightRequest="40"
                    Text="Přidat hru"
                    TextColor="White"
                    WidthRequest="140" />


            </FlexLayout>
        </ScrollView>

        <!--  Seznam her  -->
        <CollectionView
            Grid.Row="1"
            IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
            ItemsSource="{Binding Hry}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:HraDto">
                    <Border
                        Margin="0,10"
                        Padding="16"
                        BackgroundColor="White"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="700"
                        Stroke="#cccccc"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">

                        <Grid
                            ColumnDefinitions="3*,auto"
                            ColumnSpacing="12"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="6">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{Binding Nazev}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="14"
                                Text="{Binding Vydavatel.Nazev}"
                                TextColor="#555" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="14"
                                Text="{Binding RokVydani}"
                                TextColor="#777" />

                            <FlexLayout
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,5,0,0"
                                AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding Zanry}"
                                Direction="Row"
                                Wrap="Wrap">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Margin="2"
                                            Padding="6,2"
                                            BackgroundColor="#e0e0e0"
                                            StrokeShape="RoundRectangle 8">
                                            <Label
                                                FontSize="12"
                                                Text="{Binding}"
                                                TextColor="#333" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <VerticalStackLayout
                                Grid.RowSpan="4"
                                Grid.Column="1"
                                Spacing="10"
                                VerticalOptions="Center">
                                <Button
                                    BackgroundColor="#FFC107"
                                    Clicked="OnEditHraClicked"
                                    CornerRadius="10"
                                    FontSize="14"
                                    HeightRequest="36"
                                    Text="Upravit"
                                    TextColor="Black"
                                    WidthRequest="90" />

                                <Button
                                    BackgroundColor="#F44336"
                                    Clicked="OnDeleteHraClicked"
                                    CornerRadius="10"
                                    FontSize="14"
                                    HeightRequest="36"
                                    Text="Odstranit"
                                    TextColor="White"
                                    WidthRequest="90" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.RowSpan="2"
            HeightRequest="80"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="80"
            Color="DarkBlue" />
    </Grid>
</ContentPage>
