<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.AdminPrehledPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="🛠️ Admin Centrum"
    BackgroundColor="#f2f2f2">

    <ScrollView>
        <VerticalStackLayout
            Padding="40"
            HorizontalOptions="Center"
            MaximumWidthRequest="600"
            Spacing="30"
            VerticalOptions="Center">



            <Button
                BackgroundColor="#007AFF"
                Clicked="OnSeznamUzivateluClicked"
                CornerRadius="12"
                FontSize="16"
                HeightRequest="48"
                HorizontalOptions="Fill"
                Text="👤 Seznam uživatelů"
                TextColor="White" />

            <Button
                BackgroundColor="#4CAF50"
                Clicked="OnSeznamHerAdminClicked"
                CornerRadius="12"
                FontSize="16"
                HeightRequest="48"
                HorizontalOptions="Fill"
                Text="🎮 Seznam her"
                TextColor="White" />

            <Button
                BackgroundColor="#673AB7"
                Clicked="OnZanrVydavatelClicked"
                CornerRadius="12"
                FontSize="16"
                HeightRequest="48"
                HorizontalOptions="Fill"
                Text="🎭🏢 Žánry a Vydavatelé"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
