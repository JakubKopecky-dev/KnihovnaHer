<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:KnihovnaHer.Dto;assembly=KnihovnaHer.Dto"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="🎮 Můj seznam her"
    x:DataType="viewModels:MainSeznamHerViewModel">

    <Grid BackgroundColor="#f2f2f2">
        <ScrollView>
            <VerticalStackLayout
                Padding="24"
                HorizontalOptions="Center"
                MaximumWidthRequest="1000"
                Spacing="24">

                <!--  Tlačítka  -->
                <FlexLayout
                    Margin="0,0,0,12"
                    AlignItems="Center"
                    Direction="Row"
                    JustifyContent="Center"
                    Wrap="Wrap">
                    <Button
                        Clicked="OnSeznamHerClicked"
                        Style="{StaticResource MenuButtonStyle}"
                        Text="Seznam her"
                        WidthRequest="150" />

                    <Button
                        Clicked="OnAdminClicked"
                        IsVisible="{Binding IsAdmin}"
                        Style="{StaticResource MenuButtonStyle}"
                        Text="Admin centrum"
                        WidthRequest="150" />

                    <Button
                        Clicked="OnOdhlasitClicled"
                        Style="{StaticResource MenuButtonStyle}"
                        Text="Odhlásit"
                        WidthRequest="150" />
                </FlexLayout>

                <!--  Seznam her  -->
                <CollectionView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" ItemsSource="{Binding StatusyHer}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:StatusHryViewDto">
                            <Border
                                Margin="0,10"
                                Padding="16"
                                BackgroundColor="White"
                                HorizontalOptions="Center"
                                MaximumWidthRequest="700"
                                Stroke="#cccccc"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">

                                <Grid
                                    ColumnDefinitions="3*,auto"
                                    ColumnSpacing="12"
                                    RowDefinitions="Auto,Auto,Auto,Auto"
                                    RowSpacing="6">

                                    <!--  Info o hře  -->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="20"
                                        Text="{Binding Hra.Nazev}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="{Binding Hra.Vydavatel.Nazev}"
                                        TextColor="#555" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        FontSize="14"
                                        Text="{Binding Hra.RokVydani}"
                                        TextColor="#777" />

                                    <!--  Žánry  -->
                                    <FlexLayout
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,5,0,0"
                                        AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding Hra.Zanry}"
                                        Direction="Row"
                                        Wrap="Wrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Margin="2"
                                                    Padding="6,2"
                                                    BackgroundColor="#e0e0e0"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding}"
                                                        TextColor="#333" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>

                                    <!--  Akční tlačítka  -->
                                    <VerticalStackLayout
                                        Grid.RowSpan="4"
                                        Grid.Column="1"
                                        Spacing="10"
                                        VerticalOptions="Center">
                                        <Button
                                            BackgroundColor="#FFC107"
                                            CornerRadius="10"
                                            FontSize="14"
                                            HeightRequest="36"
                                            Text="Detail"
                                            TextColor="Black"
                                            WidthRequest="90" />
                                        <Button
                                            BackgroundColor="#F44336"
                                            Clicked="OnDeleteStatusHryClicked"
                                            CornerRadius="10"
                                            FontSize="14"
                                            HeightRequest="36"
                                            Text="Odebrat"
                                            TextColor="White"
                                            WidthRequest="90" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Loading  -->
        <ActivityIndicator
            HeightRequest="80"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="80"
            Color="DarkBlue" />
    </Grid>
</ContentPage>
