<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.PridatHruPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uiModels="clr-namespace:KnihovnaHer.Maui.UiModels"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="🆕 Přidat novou hru"
    x:DataType="viewModels:VytvoritHruViewModel"
    BackgroundColor="#f2f2f2">

    <ScrollView>
        <VerticalStackLayout
            Padding="40"
            HorizontalOptions="Center"
            MaximumWidthRequest="900"
            Spacing="12">

            <Label
                Margin="0,8,0,0"
                FontSize="20"
                Text="Název hry" />
            <Border
                Padding="10"
                BackgroundColor="#eeeeee"
                StrokeShape="RoundRectangle 8">
                <Entry
                    FontSize="16"
                    Placeholder="Název hry"
                    Text="{Binding Nazev}" />
            </Border>

            <Label
                Margin="0,12,0,0"
                FontSize="20"
                Text="Rok vydání" />
            <Border
                Padding="10"
                BackgroundColor="#eeeeee"
                StrokeShape="RoundRectangle 8">
                <Entry
                    FontSize="16"
                    Keyboard="Numeric"
                    Placeholder="Např. 2025"
                    Text="{Binding RokVydani}" />
            </Border>

            <Label
                Margin="0,12,0,0"
                FontSize="20"
                Text="Žánry" />
            <CollectionView Margin="0,0,0,10" ItemsSource="{Binding ZanryKVyberu}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="uiModels:VyberZanr">
                        <HorizontalStackLayout Padding="6" Spacing="12">
                            <CheckBox IsChecked="{Binding JeVybrany, Mode=TwoWay}" />
                            <Label
                                FontSize="16"
                                Text="{Binding Nazev}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Margin="0,12,0,0"
                FontSize="20"
                Text="Vydavatel" />
            <Border
                Padding="10"
                BackgroundColor="#eeeeee"
                StrokeShape="RoundRectangle 8">
                <Picker
                    FontSize="16"
                    ItemDisplayBinding="{Binding Nazev}"
                    ItemsSource="{Binding Vydavatele}"
                    SelectedItem="{Binding VybranyVydavatele}" />
            </Border>

            <Button
                x:Name="SaveButton"
                Margin="0,20,0,0"
                Padding="16"
                BackgroundColor="#4CAF50"
                Clicked="OnPridatHruClicked"
                CornerRadius="12"
                FontSize="18"
                Text="Přidat hru"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
