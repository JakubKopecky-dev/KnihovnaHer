<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.SeznamUzivateluPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:KnihovnaHer.Dto;assembly=KnihovnaHer.Dto"
    xmlns:viewmodel="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="Seznam uživatelů"
    x:DataType="viewmodel:SeznamUzivateluViewModel">

    <Grid BackgroundColor="#f2f2f2" RowDefinitions="Auto,*">
        <!--  Hlavička s tlačítkem  -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="16"
            Spacing="12">

            <HorizontalStackLayout Margin="0,0,0,7" Spacing="30">
                <Button
                    Padding="10"
                    BackgroundColor="#4caf50"
                    Clicked="OnVytvoritUzivateleClicked"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="Přidat uživatele"
                    TextColor="White" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!--  Obsah se seznamem  -->
        <ScrollView Grid.Row="1">
            <CollectionView
                Margin="16,0"
                IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                ItemsSource="{Binding Uzivatele}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UzivatelDto">
                        <Border
                            Margin="0,5"
                            Padding="8"
                            BackgroundColor="White"
                            HorizontalOptions="Center"
                            MaximumWidthRequest="800"
                            Stroke="#cccccc"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">

                            <Grid
                                Padding="8"
                                ColumnDefinitions="4*,2*,auto"
                                ColumnSpacing="10"
                                RowDefinitions="Auto">

                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="{Binding Email}"
                                    TextColor="#222"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    IsVisible="{Binding IsAdmin}"
                                    Text="Admin"
                                    TextColor="DarkGreen"
                                    VerticalOptions="Center" />


                                <HorizontalStackLayout Grid.Column="2" Spacing="10">

                                    <Button
                                        Padding="4"
                                        BackgroundColor="#FFC107"
                                        Clicked="OnOpravneniClicked"
                                        CornerRadius="10"
                                        FontSize="14"
                                        HeightRequest="30"
                                        HorizontalOptions="End"
                                        Text="Oprávnění"
                                        TextColor="White"
                                        WidthRequest="80" />

                                    <Button
                                        Padding="4"
                                        BackgroundColor="#F44336"
                                        Clicked="OnDeleteUzivatelClicked"
                                        CornerRadius="10"
                                        FontSize="14"
                                        HeightRequest="30"
                                        HorizontalOptions="End"
                                        Text="Odstranit"
                                        TextColor="White"
                                        WidthRequest="80" />

                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!--  Loading indikátor  -->
        <ActivityIndicator
            Grid.RowSpan="2"
            HeightRequest="80"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="80"
            Color="DarkBlue" />
    </Grid>
</ContentPage>