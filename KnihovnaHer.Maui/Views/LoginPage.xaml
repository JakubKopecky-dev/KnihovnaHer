<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KnihovnaHer.Maui.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:KnihovnaHer.Maui.ViewModels"
    Title="Přihlášení"
    x:DataType="viewModels:LoginViewModel"
    BackgroundColor="#f2f2f2">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="32"
                HorizontalOptions="Center"
                MaximumWidthRequest="800"
                Spacing="24"
                VerticalOptions="Center">

                <Border
                    Padding="24"
                    BackgroundColor="White"
                    HorizontalOptions="Fill"
                    MinimumWidthRequest="500"
                    Stroke="#ddd"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1">

                    <VerticalStackLayout HorizontalOptions="Fill" Spacing="20">

                        <Label
                            FontAttributes="Bold"
                            FontSize="26"
                            HorizontalOptions="Center"
                            Text="Vítejte zpět!"
                            TextColor="#222" />

                        <Border
                            Padding="10"
                            BackgroundColor="#f0f0f0"
                            StrokeShape="RoundRectangle 8">
                            <Entry
                                HorizontalOptions="Fill"
                                Keyboard="Email"
                                Placeholder="Email"
                                Text="{Binding Email}" />
                        </Border>

                        <Border
                            Padding="10"
                            BackgroundColor="#f0f0f0"
                            StrokeShape="RoundRectangle 8">
                            <Entry
                                HorizontalOptions="Fill"
                                IsPassword="True"
                                Placeholder="Heslo"
                                Text="{Binding Password}" />
                        </Border>

                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasError}"
                            LineBreakMode="WordWrap"
                            Text="{Binding ErrorMessage}"
                            TextColor="Red" />

                        <Button
                            Padding="12"
                            BackgroundColor="#007AFF"
                            Clicked="OnLoginClicked"
                            CornerRadius="12"
                            FontSize="16"
                            HorizontalOptions="Fill"
                            Text="Přihlásit"
                            TextColor="White" />

                        <Button
                            BackgroundColor="Transparent"
                            Clicked="OnRegisterClicked"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="Nemáte účet? Registrujte se"
                            TextColor="#007AFF" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
